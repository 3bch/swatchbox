{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "sortImports": {
    "ignoreCase": false
  },
  "jsdoc": {
    "addDefaultToDescription": false,
    // 日本語の説明を英字の識別子から書き始めることが多く、勝手に大文字化されると壊れる
    "capitalizeDescriptions": false
  },
  "overrides": [
    {
      "files": ["**/*.{yaml,yml}"],
      "options": {
        "singleQuote": true
      }
    }
  ]
}
