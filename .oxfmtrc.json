{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "sortImports": {
    "ignoreCase": false
  },
  "jsdoc": {
    "addDefaultToDescription": false,
    // 日本語の説明を英字の識別子から書き始めることが多く、勝手に大文字化されると壊れる
    "capitalizeDescriptions": false,
    "commentLineStrategy": "multiline",
    // 1 行の長さを超えてない範囲であれば元の改行位置を尊重する
    "lineWrappingStyle": "balance"
  },
  "sortTailwindcss": {
    // プロジェクトのテーマ（色や角丸のトークン）を並び順の判定に使う
    "stylesheet": "./src/index.css",
    "functions": ["cn"]
  },
  // shadcn/ui の生成物は、再インストールで差分が出ないようにフォーマットしない
  "ignorePatterns": ["src/components/ui/**"],
  "overrides": [
    {
      "files": ["**/*.{yaml,yml}"],
      "options": {
        "singleQuote": true
      }
    }
  ]
}
