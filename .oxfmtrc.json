{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "sortImports": {
    "ignoreCase": false
  },
  "jsdoc": {
    "addDefaultToDescription": false
  },
  "overrides": [
    {
      "files": ["**/*.{yaml,yml}"],
      "options": {
        "singleQuote": true
      }
    }
  ]
}
