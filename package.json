{
  "name": "swatchbox",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm run --sequential --no-bail \"/^check:/\"",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "check:type": "tsc --noEmit",
    "check:yaml": "eslint",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt --write",
    "fix:yaml": "eslint --fix"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-yml": "^3.8.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tinyexec": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24",
    "npm": "please-use-pnpm"
  }
}
