{
  "name": "swatchbox",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#oxlint-plugin/*": "./oxlint-plugin/*",
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm run --sequential --no-bail \"/^check:/\"",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "check:type": "tsc --build",
    "check:yaml": "eslint",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt --write",
    "fix:yaml": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.34",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "@tanstack/router-plugin": "^1.168.37",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-import-resolver-oxc": "^0.15.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-yml": "^3.8.1",
    "oxc-resolver": "^11.24.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tinyexec": "^1.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zod": "^4.6.1"
  },
  "engines": {
    "node": ">=24",
    "npm": "please-use-pnpm"
  }
}
