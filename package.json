{
  "name": "swatchbox",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#oxlint-plugin/*": "./oxlint-plugin/*",
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm run --sequential --no-bail \"/^check:/\"",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "check:type": "tsc --build",
    "check:yaml": "eslint",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt --write",
    "fix:yaml": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-router": "^1.170.36",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.38",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-import-resolver-oxc": "^0.15.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-yml": "^3.8.1",
    "oxc-resolver": "^11.24.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tinyexec": "^1.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24",
    "npm": "please-use-pnpm"
  }
}
