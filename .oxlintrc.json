{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "jsx-a11y",
    "promise",
    "vitest",
    "jsdoc"
  ],

  // このリポジトリ専用のルールは oxlint-plugin/ にある。boundaries は routes の
  // 依存の向きを縛るために入れている（設定は settings と rules を参照）
  "jsPlugins": ["./oxlint-plugin/index.ts", "eslint-plugin-boundaries"],

  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "style": "off",
    "restriction": "off",
    "pedantic": "off",
    "nursery": "off"
  },

  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },

  "rules": {
    // oxfmt の sortImports は import 宣言の並べ替えのみ行うため、
    // 宣言内の specifier のソートは oxlint 側で担当する
    "eslint/sort-imports": ["error", { "ignoreDeclarationSort": true }],

    // 比較演算子の向きを `<` / `<=` に統一する（自前実装のルール）
    "local/prefer-less-than": "error",

    // src/routes/ 以下のディレクトリ構成を統一する（自前実装のルール）
    "local/routes-structure": "error",

    // --- boundaries --- //
    // settings.import/resolver が効かなくなると #/* の import は unknown 扱いになり、
    // boundaries/dependencies は何も報告しないまま素通りする。それを鳴らすための番人。
    // （リゾルバを外して違反 import を置き、このルールだけが報告することを確認済み）
    "boundaries/no-unknown-dependencies": "error",

    // ルート同士を切り離す。既定は allow のままにして routes に関わる 2 方向だけ塞ぐ。
    // 全体を disallow で組む層構造は、まだ src/routes しか無い段階では宣言する対象が
    // 無く、外部パッケージまで許可を列挙する羽目になるので割に合わない。
    // import / 再 export / 動的 import / require のすべてが既定で検査対象になる
    "boundaries/dependencies": [
      "error",
      {
        "default": "allow",
        "policies": [
          {
            "from": { "element": { "type": "route" } },
            "disallow": {
              "to": {
                "element": {
                  "type": "route",
                  "captured": { "route": "!{{ from.element.captured.route }}" }
                }
              }
            },
            "message": "route '{{ from.element.captured.route }}' から route '{{ to.element.captured.route }}' を import できません。共有するものは src/components/ などへ移してください"
          },
          {
            "from": { "element": { "type": "!route" } },
            "disallow": { "to": { "element": { "type": "route" } } },
            "message": "routes の外から route '{{ to.element.captured.route }}' を import できません。ルートは routeTree.gen.ts 経由でのみ参照されます"
          }
        ]
      }
    ],

    "eslint/eqeqeq": "error",
    "eslint/no-var": "error",
    "eslint/unicode-bom": "error",
    "eslint/no-new-func": "error",
    "eslint/no-nested-ternary": "error",
    "eslint/no-multi-assign": "error",
    "eslint/no-implicit-coercion": "error",
    "eslint/curly": "error",
    "eslint/no-proto": "error",
    "eslint/no-sequences": ["error", { "allowInParentheses": false }],
    "eslint/no-void": "error",
    "eslint/no-array-constructor": "error",
    "eslint/no-prototype-builtins": "error",
    "eslint/prefer-template": "error",
    "eslint/prefer-const": "error",
    "eslint/object-shorthand": "error",
    "eslint/prefer-object-spread": "error",
    "eslint/no-param-reassign": "error",
    "eslint/default-param-last": "error",
    "eslint/no-useless-rename": "error",
    "eslint/radix": "error",
    "eslint/no-console": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useMemo", "useCallback", "memo"],
            "message": "React Compiler 導入予定のため、手動メモ化は不要です"
          }
        ],
        // 相対パス import の禁止
        "patterns": [
          {
            "regex": "^[.][.]?/",
            "message": "相対パス import は禁止です。#/* を使ってください"
          }
        ]
      }
    ],

    // --- バグ・やり残しの検出 --- //
    "eslint/array-callback-return": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/no-constructor-return": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-loop-func": "error",
    "eslint/no-unreachable-loop": "error",
    "eslint/no-useless-assignment": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-inner-declarations": "error",
    "eslint/no-return-assign": "error",

    // --- 冗長な記述の除去（多くは --fix で自動修正される） --- //
    "eslint/no-else-return": "error",
    "eslint/no-lonely-if": "error",
    // 検出範囲は unicorn/no-negated-condition と完全に同一。
    // unicorn 側が本家の置き換えとして作られており、unopinionated ベースの方針に合わせて
    // そちらへ寄せる（oxlint ではどちらも --fix に対応する）
    "eslint/no-negated-condition": "off",
    "eslint/arrow-body-style": "error",
    "eslint/no-useless-computed-key": "error",
    "eslint/operator-assignment": "error",
    "eslint/logical-assignment-operators": "error",
    "eslint/prefer-object-has-own": "error",
    "eslint/prefer-exponentiation-operator": "error",
    "eslint/prefer-numeric-literals": "error",
    "eslint/prefer-regex-literals": "error",
    "eslint/no-useless-return": "error",
    "eslint/prefer-arrow-callback": "error",
    "eslint/symbol-description": "error",

    // --- 書き方の揺れ防止 --- //
    // 関数式は禁止し、宣言かアロー関数に寄せる
    "eslint/func-style": ["error", "declaration", { "allowArrowFunctions": true }],
    "eslint/default-case-last": "error",
    "eslint/new-cap": "error",
    "eslint/guard-for-in": "error",
    "eslint/no-labels": "error",

    // --- エラーの握りつぶしの検出 --- //
    // 空にする意図があるなら noop などのコメントを書く
    "eslint/no-empty": "error",
    "eslint/no-empty-function": "error",
    "eslint/no-alert": "error",
    "eslint/no-script-url": "error",
    "eslint/no-template-curly-in-string": "error",

    "oxc/bad-bitwise-operator": "error",
    "oxc/no-barrel-file": "error",
    "oxc/approx-constant": "error",
    // 分岐の先頭・末尾で重複しているコードを検出する
    "oxc/branches-sharing-code": "error",

    // --- typescript --- //
    // typescript-eslint 8.69.0 の strict-type-checked をベースに、
    // stylistic-type-checked から書き方を固定するものを足した構成にする。
    // categories で自動的に有効になるもの（correctness / suspicious / perf）は
    // unicorn / react と同様ここに書かない。型情報を使うルールも categories で
    // 有効になるため、前提は options.typeAware: true だけになる。
    // 選定の詳細は oxlint-rules-research.md を参照

    // --- 型安全性の穴を塞ぐ --- //
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    // delete する動的キーは Map / Set で持つ
    "typescript/no-dynamic-delete": "error",
    // @ts-ignore を禁じ、@ts-expect-error と理由の記述を要求する。
    // 前者は対象行のエラーが消えても黙って残り続ける
    "typescript/ban-ts-comment": "error",
    // .catch(err => …) の err を unknown として扱わせる
    "typescript/use-unknown-in-catch-callback-variable": "error",

    // --- Promise・非同期の取り扱い --- //
    "typescript/no-misused-promises": "error",
    "typescript/require-await": "error",
    "typescript/return-await": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",

    // --- 型が示す前提の検証 --- //
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-deprecated": "error",
    "typescript/restrict-plus-operands": "error",
    // getter の型が setter に代入できない組み合わせを検出する
    "typescript/related-getter-setter-pairs": "error",

    // --- 書き方の統一 --- //
    "typescript/array-type": ["error", { "default": "array-simple" }],
    "typescript/consistent-type-definitions": "error",
    "typescript/consistent-indexed-object-style": "error",
    // 型引数はコンストラクタ側に寄せる（new Map<K, V>() の形）
    "typescript/consistent-generic-constructors": "error",
    // 型アサーションは as に統一する（<T>x は .tsx で書けない）
    "typescript/consistent-type-assertions": "error",
    // リテラルを返すだけの getter は readonly フィールドにする
    "typescript/class-literal-property-style": "error",
    "typescript/prefer-function-type": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-require-imports": "error",
    "typescript/adjacent-overload-signatures": "error",
    // ユニオンひとつにまとめられるオーバーロードを検出する
    "typescript/unified-signatures": "error",

    // --- モダンな API・冗長さの除去 --- //
    "typescript/prefer-for-of": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-includes": "error",
    // .filter(…)[0] を .find(…) にする
    "typescript/prefer-find": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    // 捕捉した文字列を使わない場面では String#match より RegExp#exec が速い
    "typescript/prefer-regexp-exec": "error",
    // reduce の初期値の as を型引数に移す
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-return-this-type": "error",
    "typescript/dot-notation": "error",

    // --- プリセット外から採用しているもの --- //
    // verbatimModuleSyntax と組で、型の import / export を type 付きに固定する
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-import-type-side-effects": "error",
    // インタフェースのメソッドはプロパティ形式に統一する。
    // メソッド形式は引数の型が bivariant になり、型検査が緩くなる
    "typescript/method-signature-style": "error",
    // 条件式には boolean だけを許す。空文字や 0 の暗黙の falsy を潰す
    "typescript/strict-boolean-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",

    // --- 採用しないもの --- //
    // stylistic-type-checked に含まれるが、no-non-null-assertion と正面から衝突する。
    // `x as string` に「! を使え」と言う一方で `x!` は no-non-null-assertion が禁じるため、
    // どちらの書き方も残せなくなる。非 null の絞り込みは型ガードで書く方針を取る
    "typescript/non-nullable-type-assertion-style": "off",
    // strict-type-checked に含まれるが、tsconfig の erasableSyntaxOnly が
    // enum と namespace の構文自体を禁じているため対象コードが生まれない
    // （no-mixed-enums / prefer-literal-enum-member / no-namespace）

    // --- unicorn --- //
    // eslint-plugin-unicorn の unopinionated プリセット（v74.0.0）をベースにする。
    // recommended は `no-null` や `filename-case` のような主張の強いルールまで含むため、
    // 「異論の出にくいもの」だけを集めた unopinionated を採用した。
    // 対象は unopinionated の 215 件のうち oxlint が実装している 112 件
    // （旧名で実装されているものを含む）。
    // うち correctness / suspicious / perf の 23 件は categories により自動で有効になるため、
    // ここに書くのは pedantic / style / restriction / nursery のものだけとする。
    // 選定の詳細は oxlint-rules-research.md を参照

    // --- バグ・間違いやすい API の検出 --- //
    "unicorn/error-message": "error",
    "unicorn/prefer-type-error": "error",
    "unicorn/catch-error-name": "error",
    "unicorn/no-useless-error-capture-stack-trace": "error",
    "unicorn/consistent-date-clone": "error",
    "unicorn/no-array-method-this-argument": "error",
    "unicorn/no-object-as-default-parameter": "error",
    "unicorn/no-this-assignment": "error",
    "unicorn/no-typeof-undefined": "error",
    "unicorn/no-negation-in-equality-check": "error",
    "unicorn/require-number-to-fixed-digits-argument": "error",
    "unicorn/require-array-join-separator": "error",
    "unicorn/no-magic-array-flat-depth": "error",
    "unicorn/no-unnecessary-array-splice-count": "error",
    "unicorn/explicit-timer-delay": "error",
    "unicorn/no-process-exit": "error",
    "unicorn/text-encoding-identifier-case": "error",
    "unicorn/relative-url-style": "error",
    "unicorn/require-module-attributes": "error",

    // --- 冗長な記述の除去（多くは --fix で自動修正される） --- //
    // eslint/no-lonely-if は else ブロック内、unicorn/no-lonely-if は else を持たない
    // if ブロック内を見る。検出範囲が排他的なので両方を有効にする
    "unicorn/no-lonely-if": "error",
    "unicorn/no-negated-condition": "error",
    "unicorn/no-useless-undefined": "error",
    "unicorn/no-useless-switch-case": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "unicorn/no-useless-collection-argument": "error",
    "unicorn/no-useless-iterator-to-array": "error",
    "unicorn/no-unnecessary-array-flat-depth": "error",
    "unicorn/no-unnecessary-slice-end": "error",
    "unicorn/no-zero-fractions": "error",
    "unicorn/no-console-spaces": "error",
    "unicorn/no-static-only-class": "error",
    "unicorn/prefer-logical-operator-over-ternary": "error",
    "unicorn/prefer-ternary": "error",
    "unicorn/prefer-default-parameters": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-single-call": "error",

    // --- モダンな標準 API への統一 --- //
    "unicorn/new-for-builtins": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-new-buffer": "error",
    "unicorn/prefer-array-flat": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-array-index-of": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-spread": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-string-trim-start-end": "error",
    "unicorn/prefer-string-raw": "error",
    "unicorn/prefer-negative-index": "error",
    "unicorn/prefer-object-from-entries": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-code-point": "error",
    "unicorn/prefer-math-min-max": "error",
    "unicorn/prefer-math-trunc": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-number-coercion": "error",
    "unicorn/prefer-native-coercion-functions": "error",
    "unicorn/prefer-prototype-methods": "error",
    "unicorn/prefer-reflect-apply": "error",
    "unicorn/prefer-bigint-literals": "error",
    "unicorn/prefer-class-fields": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/escape-case": "error",
    // unopinionated の prefer-unicode-code-point-escapes に相当する（oxlint は旧名で実装）
    "unicorn/no-hex-escape": "error",
    "unicorn/numeric-separators-style": "error",

    // --- DOM / ブラウザ API --- //
    "unicorn/prefer-query-selector": "error",
    "unicorn/prefer-dom-node-append": "error",
    "unicorn/prefer-dom-node-remove": "error",
    "unicorn/prefer-dom-node-text-content": "error",
    "unicorn/prefer-dom-node-dataset": "error",
    "unicorn/prefer-modern-dom-apis": "error",
    "unicorn/prefer-classlist-toggle": "error",
    "unicorn/prefer-keyboard-event-key": "error",
    "unicorn/prefer-event-target": "error",
    "unicorn/prefer-blob-reading-methods": "error",
    "unicorn/prefer-response-static-json": "error",
    "unicorn/prefer-global-this": "error",
    "unicorn/no-document-cookie": "error",

    // --- モジュール・非同期 --- //
    "unicorn/prefer-module": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/import-style": "error",
    "unicorn/prefer-top-level-await": "error",
    "unicorn/no-await-expression-member": "error",

    // --- 可読性 --- //
    "unicorn/no-unreadable-array-destructuring": "error",
    "unicorn/no-unreadable-iife": "error",
    "unicorn/consistent-existence-index-check": "error",
    "unicorn/no-abusive-eslint-disable": "error",

    // unopinionated に含まれるが採用しないもの
    // oxfmt が 16 進リテラルを小文字化する（0xFF -> 0xff）のに対し、
    // このルールは大文字を要求するため、両者が互いの結果を打ち消し合う。
    // 本家にある hexadecimalValue オプションは oxlint 版では未対応
    "unicorn/number-literal-case": "off",
    // import/no-anonymous-default-export が上位互換（関数・クラスに加えて
    // オブジェクト・配列・インスタンス・リテラルも検出する）。
    // unicorn 版の差分は module.exports 形式への対応のみで、ESM 専用の本リポジトリでは効かない
    "unicorn/no-anonymous-default-export": "off",
    // typescript/prefer-includes が上位互換。型情報を使うため indexOf() !== -1 に加えて
    // /foo/.test(s) のような正規表現による存在判定も String#includes() に寄せられる
    "unicorn/prefer-includes": "off",

    "import/consistent-type-specifier-style": ["error", "prefer-top-level-if-only-type-imports"],
    "import/no-anonymous-default-export": "error",
    // default export は import 側で名前を変えられるため、リネーム追跡と grep 可能性を壊す。
    // ツールの規約で default export が必須のファイルだけ overrides で除外している
    "import/no-default-export": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "error",
      { "allow": ["@testing-library/jest-dom/vitest", "**/*.css"] }
    ],
    "import/no-duplicates": ["error", { "preferInline": true }],
    "import/no-empty-named-blocks": "error",
    "import/no-mutable-exports": "error",
    // default export と named export を併せ持つパッケージで誤検知するため OFF
    "import/no-named-as-default-member": "off",

    // --- react --- //
    // categories で自動的に有効になるものは unicorn と同様にここへ書かない
    // （exhaustive-deps / no-array-index-key / purity / immutability など）。
    // 選定の詳細は oxlint-rules-research.md を参照

    // React 17 以降は不要なルールなので OFF
    "react/react-in-jsx-scope": "off",

    // --- コンポーネントの書き方の統一 --- //
    // 関数コンポーネントは関数宣言に固定する。ジェネリックを素直に書けること
    // （アローは .tsx で `<T,>` のカンマが必要、FC では型引数を束縛できない）と、
    // ラップしても名前が残ることが理由。ヘルパー関数はこれまでどおりアロー関数でよい。
    // HOC に渡す無名コンポーネントはアロー・関数式のどちらも許す
    "react/function-component-definition": [
      "error",
      {
        "namedComponents": "function-declaration",
        "unnamedComponents": ["arrow-function", "function-expression"]
      }
    ],
    "react/prefer-function-component": "error",
    "react/hook-use-state": "error",
    "react/jsx-pascal-case": "error",

    // --- 冗長な JSX の除去 --- //
    "react/jsx-no-useless-fragment": "error",
    "react/self-closing-comp": "error",
    "react/jsx-boolean-value": "error",
    "react/jsx-curly-brace-presence": "error",
    "react/jsx-fragments": "error",

    // --- バグ・事故の検出 --- //
    "react/rules-of-hooks": "error",
    "react/display-name": "error",
    "react/no-unknown-property": "error",
    "react/no-unescaped-entities": "error",
    "react/checked-requires-onchange-or-readonly": "error",
    "react/button-has-type": "error",
    "react/no-danger": "error",
    "react/jsx-no-target-blank": "error",
    // Fast Refresh（react-refresh 相当）。TanStack Router のルートファイルでは
    // 誤検知するため、overrides で対象から外している
    "react/only-export-components": ["error", { "allowConstantExport": true }],

    // --- 非推奨 API --- //
    "react/no-clone-element": "error",
    "react/no-react-children": "error",

    // --- React Compiler 由来のルール --- //
    // 本家 eslint-plugin-react-hooks が recommended としている 14 件のうち、
    // oxlint で有効にならないのはこれだけなので明示する
    // （config と gating は oxlint 未実装、fbt は Meta 社内向け）
    "react/unsupported-syntax": "error",
    // 以下は本家が preset を off にしているもの。oxlint では suspicious に
    // 入っていて自動で有効になるため、明示的に落とす。
    // なお同じく本家 off の exhaustive-effect-dependencies と
    // no-deriving-state-in-effects は、他ルールと重複せず実際のバグを拾うため残す
    //
    // rules-of-hooks と役割が重複する。本体実装のほうが枯れている
    "react/hooks": "off",
    // 大文字始まりの関数呼び出しを構文だけで弾くため、コンポーネントでない
    // ファクトリ関数まで巻き込む
    "react/capitalized-calls": "off",
    // useMemo / useCallback の依存配列を見るルール。no-restricted-imports で
    // 手動メモ化そのものを禁止しているため、対象コードが存在しない
    "react/memo-dependencies": "off",

    // TypeScript では type は不要なので OFF
    "jsdoc/require-property-type": "off",
    "jsdoc/empty-tags": "error",
    // @param と @returns を書くかどうかは型注釈から自明かどうかで決めるため、
    // 一律に要求はしない（判断基準は CLAUDE.md の開発ルールを参照）。
    // 書いた場合の中身は以下のルールで担保する
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off",
    "jsdoc/require-param-description": "error",
    "jsdoc/require-param-name": "error",
    "jsdoc/require-returns-description": "error",
    "jsdoc/check-tag-names": ["error", { "typed": true }],

    "vitest/consistent-vitest-vi": "error",
    "vitest/no-import-node-test": "error",
    "vitest/prefer-describe-function-title": "error",
    "vitest/prefer-called-times": "error",
    "vitest/prefer-to-be-falsy": "error",
    "vitest/prefer-to-be-truthy": "error",
    "vitest/prefer-to-be-object": "error"
  },

  "settings": {
    // --- boundaries --- //
    // 検査対象。src の外（設定ファイルや scripts/、oxlint-plugin/）まで要素分類の
    // 対象にすると、どの element にも当たらないファイルが増えるだけで得が無い
    "boundaries/include": ["src/**/*.{ts,tsx}"],

    // src/routes/<ルート名>/ の 1 つ 1 つを route という element として扱い、
    // ディレクトリ名を route という名前で捕捉する。ルールから
    // {{ from.element.captured.route }} で参照して「同じルートかどうか」を判定する。
    // src/routes/__root.tsx は routes 直下のファイルで、その親フォルダは src/routes
    // なので route には当たらず、下の app 側に落ちる。全ページ共通のレイアウトであり
    // 個別ルートには属さない、という扱いで意図どおり。
    // partialMatch を false にしてプロジェクトルートからの完全一致にする。既定の
    // true は末尾一致で、'…/routes/<何か>' で終わるパスなら src の外でも当たってしまう。
    // 本家も将来の既定を false にする予定と書いているため、最初から明示しておく
    "boundaries/elements": [
      { "type": "route", "pattern": "src/routes/*", "capture": ["route"], "partialMatch": false },
      { "type": "app", "pattern": "src", "partialMatch": false }
    ],

    // oxlint はリゾルバを既定で有効にしないため明示する。これが無いと #/* が解決できず、
    // boundaries/dependencies は違反を報告しないまま素通りする（本リポジトリでは
    // unknown 扱いになるので no-unknown-dependencies 側が鳴る）。
    // リゾルバは oxlint 本体と同じ oxc の解決系に揃えている
    "import/resolver": {
      "oxc": {
        "tsconfig": { "configFile": "./tsconfig.json", "references": "auto" }
      }
    },

    "react": {
      "version": "19"
    },
    "jsdoc": {
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false
    }
  },

  "env": {
    "builtin": true,
    "browser": true
  },

  // ツールの規約で default export が必須のファイルだけ import/no-default-export を外す。
  // overrides.files も ignorePatterns と同じく、パスを含むパターンは先頭に **/ が必要
  "overrides": [
    {
      "files": ["*.config.ts", "*.config.js", "**/oxlint-plugin/index.ts"],
      "rules": { "import/no-default-export": "off" }
    },
    // TanStack Router のルートファイルでは react/only-export-components が誤検知する。
    // このルールは「コンポーネントと非コンポーネントを同居させると Fast Refresh が
    // 効かない」という前提だが、ルートファイルの Route は router plugin が HMR を扱い、
    // コンポーネントは autoCodeSplitting で別モジュールへ切り出されるため実際には効く
    // （__root.tsx と (root)/index.tsx を書き換え、Vite のログが hmr update のみで
    // フルリロードが起きないことを確認済み）。
    // ルートファイルにページ本体を直書きするか -components/ へ分けるかは、規模を見て
    // 判断する。-components/ 配下はこのルールの対象のままにしてある
    {
      "files": ["**/src/routes/__root.tsx", "**/src/routes/*/{index,route}.tsx"],
      "rules": { "react/only-export-components": "off" }
    },
    // コンポーネント置き場の .tsx だけ、ファイル名を PascalCase に固定し、
    // ファイル名と同名のものを export することを要求する。
    // ルート定義ファイル（__root.tsx / index.tsx / route.tsx）はコンポーネント置き場では
    // ないため glob から外れており、巻き込まれない。
    // routes 配下は -components/ に限っている。routes-structure は `-` 始まりの
    // ディレクトリ名を何でも許すが、`-hooks/` や `-utils/` に置いた .tsx まで
    // PascalCase を求める理由は無く、縛る対象を「コンポーネント置き場」に限定するため。
    // shadcn/ui の生成物（components/ui/）は ignorePatterns で既に除外されている
    {
      "files": ["**/src/components/**/*.tsx", "**/src/routes/*/-components/*.tsx"],
      "rules": {
        "unicorn/filename-case": ["error", { "case": "pascalCase" }],
        "local/component-file-name": "error"
      }
    }
  ],

  // shadcn/ui の生成物と TanStack Router の生成ファイルは対象外とする。
  // ignorePatterns は先頭に **/ を付けないとマッチしない点に注意
  "ignorePatterns": ["**/components/ui/**", "**/routeTree.gen.ts"]
}
